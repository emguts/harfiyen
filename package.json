{
  "name": "harfiyen",
  "private": true,
  "version": "0.5.0",
  "description": "Türkçe konuşmayı yazıya döken, videoya altyazı yazan masaüstü uygulaması",
  "author": "Harfiyen contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "typecheck": "tsc -b",
    "models": "python3 scripts/prepare_models.py",
    "upload-models": "python3 scripts/upload_models.py",
    "test:engine": "tsx tests/engine.node.ts",
    "test:whisper": "tsx tests/whisper.node.ts",
    "test:formatter": "tsx tests/formatter.node.ts",
    "test:translate": "tsx tests/translate.node.ts",
    "eval:punct": "tsx tests/punct-eval.node.ts",
    "test:numbers": "tsx tests/numbers.node.ts",
    "test:timing": "tsx tests/timing.node.ts",
    "test:align": "tsx tests/align.node.ts",
    "test:cuts": "tsx tests/cuts.node.ts",
    "test:speakers": "tsx tests/speakers.node.ts",
    "test:diarize": "tsx tests/diarize.node.ts",
    "test:vocals": "tsx tests/vocals.node.ts",
    "eval:numbers": "tsx tests/numbers-eval.node.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:azure": "npm run build && electron-builder --win nsis --x64 --publish never --config electron-builder.azure.yml",
    "dist:appx": "npm run build && electron-builder --win appx --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mas": "npm run build && electron-builder --mac mas --publish never",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "electron": "^45.0.0",
    "electron-builder": "26.15.3",
    "matter-js": "^0.20.0",
    "mediabunny": "^1.61.3",
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
