# Optional: leave unset to use local model files and the bundled WASM runtime.
# For Cloudflare Pages, set both values in the build environment.
VITE_MODELS_BASE_URL=https://YOUR-R2-PUBLIC-HOST/models
VITE_ORT_WASM_URL=https://YOUR-R2-PUBLIC-HOST/runtime/ort-wasm-simd-threaded.asyncify.wasm

# Only for `npm run upload-models`. Put real values in .env.local (git-ignored),
# never in this file. R2 > Manage API tokens: Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
